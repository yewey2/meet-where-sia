{
  "name": "meet-where-sia",
  "private": true,
  "version": "0.1.0",
  "description": "A fair meeting-point planner for groups travelling around Singapore by MRT and LRT.",
  "keywords": [
    "singapore",
    "meetup-planner",
    "mrt",
    "lrt",
    "transit",
    "react"
  ],
  "homepage": "https://meet-where-sia.vercel.app",
  "bugs": {
    "url": "https://github.com/yewey2/meet-where-sia/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yewey2/meet-where-sia.git"
  },
  "funding": [
    "https://github.com/sponsors/yewey2",
    "https://ko-fi.com/sycprojects"
  ],
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/local.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/local.js",
    "check": "tsc -b --pretty false",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.65.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
